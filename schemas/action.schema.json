{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/schemas/action.schema.json",
  "title": "DeviceAction",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "args", "confidence"],
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "set_detect_threshold",
        "set_alarm_zone",
        "set_alarm_channel",
        "mute_alarms",
        "reboot_stream",
        "get_status",
        "need_clarification",
        "reject"
      ]
    },
    "args": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "maxLength": 200
    }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "set_detect_threshold" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "value": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "set_alarm_zone" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled"],
            "properties": {
              "enabled": { "type": "boolean" },
              "camera_id": { "type": "integer", "minimum": 0, "maximum": 3 },
              "polygon": {
                "type": "array",
                "minItems": 3,
                "maxItems": 8,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "set_alarm_channel" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel"],
            "properties": {
              "channel": { "type": "string", "enum": ["log", "beep", "mqtt"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "mute_alarms" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seconds"],
            "properties": {
              "seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "reboot_stream" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["camera_id"],
            "properties": {
              "camera_id": { "type": "integer", "minimum": 0, "maximum": 3 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "get_status" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "need_clarification" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question"],
            "properties": {
              "question": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "reject" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "forbidden",
                  "out_of_range",
                  "ambiguous",
                  "unsupported",
                  "inject_attempt"
                ]
              },
              "message": { "type": "string", "maxLength": 200 }
            }
          }
        }
      }
    }
  ]
}
